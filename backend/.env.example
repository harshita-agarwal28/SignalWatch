# Server
PORT=4000
JWT_SECRET=dev-secret-change-me
CORS_ORIGIN=http://localhost:5173

# Database (SQLite file, created automatically)
DATABASE_URL="file:./dev.db"

# Feed the server BOOTS with: "simulated" (no key needed) or "live" (Finnhub).
# The Settings page can switch this at runtime without a restart.
MARKET_DATA_MODE=simulated

# Only needed if MARKET_DATA_MODE=live
# Free key from https://finnhub.io/register (60 calls/min on the free tier)
FINNHUB_API_KEY=

# How often the simulated market engine ticks, in milliseconds
TICK_INTERVAL_MS=5000
